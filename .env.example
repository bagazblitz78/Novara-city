# =============================================================================
# Novara City — environment template
# Copy to `.env` and fill in real values. `.env` is gitignored and must never
# be committed. All values below are placeholders only.
# =============================================================================

# ---- Database ---------------------------------------------------------------
# Local development uses SQLite (zero setup).
DATABASE_URL="file:./dev.db"

# Production uses PostgreSQL. Example:
# DATABASE_URL="postgresql://novara:change-me@db.internal:5432/novara_city?schema=public"

# ---- Application ------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3000

# ---- Security ---------------------------------------------------------------
# Long random string used to sign session cookies.
# Generate one with:  openssl rand -base64 48
# NEVER commit a real value.
SESSION_SECRET="replace-with-a-long-random-secret"

# ---- Uploads ----------------------------------------------------------------
# Local directory for avatars/images in development.
UPLOAD_DIR="./uploads"
# Max upload size in bytes (2 MB).
UPLOAD_MAX_BYTES="2097152"

# Optional S3-compatible storage for production (e.g. Cloudflare R2 / AWS S3).
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL=""

# ---- Local production smoke tests -------------------------------------------
# A production build normally refuses to run on SQLite. Set this to "true" ONLY
# to run `next start` against SQLite locally (smoke test / single-node demo).
# A real deployment must leave this unset (or "false") and use PostgreSQL.
ALLOW_SQLITE_IN_PRODUCTION="false"

# ---- Logging ----------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL="info"
